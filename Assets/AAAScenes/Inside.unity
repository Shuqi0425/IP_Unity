  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9e685ee874f9d3940acdbcf31d5e4bbc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteractableObject
  promptMessage: Press E to Interact
  dialogueLines:
  - text: 'You have just secured a job in the Singapore Police Force. '
    hasChoices: 0
    choices: []
  - text: The job is a lowly traffic police, and your job is to take care of traffic
      accidents and ensure safety of the citizens of Singapore.
    hasChoices: 0
    choices: []
  - text: "As unsatisfied as you are with your new job, you take up the responsibility
      and do your job diligently. \r\n"
    hasChoices: 0
    choices: []
  - text: 'That is what your boss said as you walked into the office on the first
      day of your job; and you cant help but wonder



'
    hasChoices: 0
    choices: []
  - text: how hard can it be?
    hasChoices: 0
    choices: []
  isQuestInteraction: 0
  questNumber: 1
  completeQuestOnDialogueEnd: 1
  npcAnimator: {fileID: 0}
  waveTriggerName: wave
